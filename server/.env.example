# GB Messenger Server Configuration
# For closed messenger (family/relatives) - no domain needed

# Server
NODE_ENV=production
PORT=3000
CORS_ORIGINS=*
SERVER_IP=YOUR_SERVER_IP_HERE

# Database
POSTGRES_PASSWORD=change_me_in_production

# Redis
REDIS_PASSWORD=change_me_too

# MinIO Storage
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=change_me_minio

# JWT Secrets (generate with: openssl rand -hex 32)
JWT_ACCESS_SECRET=change_me_jwt_access
JWT_REFRESH_SECRET=change_me_jwt_refresh
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d

# Encryption Key (generate with: openssl rand -hex 32)
ENCRYPTION_KEY=change_me_encryption

# Firebase Cloud Messaging (optional - for push notifications)
FCM_PROJECT_ID=
FCM_CLIENT_EMAIL=
FCM_PRIVATE_KEY=

# LiveKit (optional - for calls)
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
LIVEKIT_URL=
